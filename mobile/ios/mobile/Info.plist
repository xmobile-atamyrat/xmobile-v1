<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Xmobile</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- STAGING ONLY: the staging server is plain HTTP on a bare IP
	     (http://216.250.13.115:3001). ATS blocks that by default, and
	     NSExceptionDomains keys must be domain names, not IP addresses,
	     so arbitrary loads is the only workable escape hatch here.
	     Internal TestFlight testers skip Beta App Review, so this never
	     reaches an Apple reviewer. MUST NOT reach main.

	     NSAllowsLocalNetworking (which React Native ships in its template)
	     is deliberately absent. On iOS 10+ the mere presence of it, or of
	     NSAllowsArbitraryLoadsInWebContent / NSAllowsArbitraryLoadsForMedia,
	     makes the system ignore NSAllowsArbitraryLoads and fall back to its
	     default of NO, which blocked the staging origin while this file still
	     read as though cleartext were allowed. Arbitrary loads is a superset
	     of local networking, so dropping the key costs the Metro and
	     localhost:3003 debug traffic nothing. Android has no equivalent
	     precedence rule, so this failed on iOS only. Do not re-add the key. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
