<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>

        <!--
          The app is always light: the WebView renders the light web app and the
          onboarding screen is white. Declaring dark bar icons in the theme
          rather than only at runtime avoids a flash of white-on-white icons
          during cold start, before JS mounts and StatusBar applies.

          windowLightNavigationBar is API 27+; minSdkVersion is 24, and older
          releases simply ignore a theme attribute they do not know.
        -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

</resources>
